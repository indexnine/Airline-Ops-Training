<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Airline Operations Basics</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#090E1A;--surface:#101827;--surface2:#162035;--surface3:#1C2A46;
  --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.12);
  --blue:#3B82F6;--blue2:#60A5FA;--blue3:#93C5FD;
  --teal:#14B8A6;--teal2:#5EEAD4;
  --amber:#F59E0B;--amber2:#FCD34D;
  --rose:#F43F5E;--rose2:#FB7185;
  --violet:#8B5CF6;--violet2:#A78BFA;
  --green:#10B981;--green2:#34D399;
  --ink:#E2E8F5;--ink2:#94A3B8;--ink3:#4B5A70;
  --r-sm:6px;--r-md:10px;--r-lg:16px;--r-xl:22px;
  --font-h:'Syne',sans-serif;
  --font-b:'Instrument Sans',sans-serif;
  --font-m:'JetBrains Mono',monospace;
}
html{scroll-behavior:smooth}
body{font-family:var(--font-b);background:var(--bg);color:var(--ink);line-height:1.6;min-height:100vh}

/* HERO */
.hero{position:relative;overflow:hidden;background:var(--bg)}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 65% -5%,rgba(59,130,246,0.18) 0%,transparent 65%),radial-gradient(ellipse 40% 40% at 5% 85%,rgba(20,184,166,0.09) 0%,transparent 55%)}
.hero-grid{position:absolute;inset:0;background-image:radial-gradient(rgba(59,130,246,0.18) 1px,transparent 1px);background-size:30px 30px;mask-image:radial-gradient(ellipse 60% 60% at 65% 20%,black,transparent 75%)}
.hero-strip{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--blue) 35%,var(--teal) 65%,transparent)}
.hero-inner{position:relative;max-width:940px;margin:0 auto;padding:64px 40px 52px}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.28);border-radius:20px;padding:5px 14px 5px 10px;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--blue3);margin-bottom:22px}
.badge-dot{width:6px;height:6px;border-radius:50%;background:var(--blue);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}
.hero h1{font-family:var(--font-h);font-size:clamp(34px,5.5vw,58px);font-weight:800;line-height:1.06;color:#fff;letter-spacing:-0.03em;margin-bottom:14px}
.hero h1 .c1{color:var(--blue2)}.hero h1 .c2{color:var(--teal2)}
.hero-sub{font-size:15px;color:var(--ink2);max-width:560px;margin-bottom:12px;line-height:1.7}
.hero-audience{display:inline-flex;align-items:center;gap:7px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.22);border-radius:var(--r-sm);padding:6px 14px;font-size:12px;color:var(--amber2);font-weight:500;margin-bottom:34px}
.hero-stats{display:flex;gap:32px;flex-wrap:wrap}
.h-stat-v{font-family:var(--font-h);font-size:26px;font-weight:700;color:#fff;line-height:1}
.h-stat-l{font-size:11px;color:var(--ink3);margin-top:3px;text-transform:uppercase;letter-spacing:0.07em}
.h-divider{width:1px;background:var(--border2);align-self:stretch}

/* PROGRESS BAR */
.prog-bar{background:rgba(16,24,39,0.95);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:200}
.prog-inner{max-width:940px;margin:0 auto;padding:0 40px;display:flex;align-items:center;gap:16px}
.prog-label{font-size:12px;color:var(--ink3);padding:14px 0;white-space:nowrap;min-width:160px}
.prog-label strong{color:var(--ink)}
.prog-track{flex:1;height:3px;background:var(--surface3);border-radius:2px;overflow:hidden}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--teal));border-radius:2px;transition:width 0.5s ease;width:0}
.prog-pct{font-family:var(--font-m);font-size:12px;color:var(--blue2);min-width:32px;text-align:right}

/* TABS */
.tabs-wrap{background:var(--surface);border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.tabs-wrap::-webkit-scrollbar{display:none}
.tabs-row{max-width:940px;margin:0 auto;padding:0 40px;display:flex}
.tab-btn{display:flex;align-items:center;gap:8px;padding:14px 16px;font-size:11.5px;font-weight:600;font-family:var(--font-h);color:var(--ink3);background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;transition:all 0.18s;white-space:nowrap;margin-bottom:-1px;letter-spacing:0.04em;text-transform:uppercase}
.tab-btn:hover{color:var(--ink);background:rgba(255,255,255,0.02)}
.tab-btn.active{color:var(--blue2);border-bottom-color:var(--blue)}
.tab-btn.done{color:var(--green2)}
.tab-btn.done .t-num{background:rgba(16,185,129,0.15);color:var(--green2)}
.t-num{width:20px;height:20px;border-radius:50%;background:var(--surface3);font-size:10px;font-weight:700;font-family:var(--font-m);display:inline-flex;align-items:center;justify-content:center;color:var(--ink3);transition:all 0.18s;flex-shrink:0}
.tab-btn.active .t-num{background:rgba(59,130,246,0.2);color:var(--blue2)}

/* MAIN */
.main{max-width:940px;margin:0 auto;padding:40px 40px 100px}
.section-panel{display:none}
.section-panel.active{display:block;animation:fadeUp 0.3s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* MODULE HEADER */
.mod-header{margin-bottom:30px}
.mod-eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.mod-tag{font-family:var(--font-m);font-size:10px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;padding:3px 10px;border-radius:4px}
.tag-blue{background:rgba(59,130,246,0.12);color:var(--blue3);border:1px solid rgba(59,130,246,0.22)}
.tag-teal{background:rgba(20,184,166,0.12);color:var(--teal2);border:1px solid rgba(20,184,166,0.22)}
.tag-amber{background:rgba(245,158,11,0.12);color:var(--amber2);border:1px solid rgba(245,158,11,0.22)}
.tag-violet{background:rgba(139,92,246,0.12);color:var(--violet2);border:1px solid rgba(139,92,246,0.22)}
.tag-rose{background:rgba(244,63,94,0.12);color:var(--rose2);border:1px solid rgba(244,63,94,0.22)}
.tag-green{background:rgba(16,185,129,0.12);color:var(--green2);border:1px solid rgba(16,185,129,0.22)}
.mod-rule{flex:1;height:1px;background:var(--border)}
.mod-title{font-family:var(--font-h);font-size:26px;font-weight:700;color:#fff;letter-spacing:-0.02em;margin-bottom:8px}
.mod-desc{font-size:14px;color:var(--ink2);line-height:1.7;max-width:660px}

/* KEY CONCEPT BOX */
.kc-box{background:linear-gradient(135deg,rgba(59,130,246,0.07),rgba(20,184,166,0.05));border:1px solid rgba(59,130,246,0.18);border-radius:var(--r-lg);padding:22px 26px;margin-bottom:26px;position:relative;overflow:hidden}
.kc-box::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--teal))}
.kc-label{font-family:var(--font-m);font-size:10px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:var(--blue3);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.kc-label::after{content:'';flex:1;height:1px;background:rgba(59,130,246,0.15)}
.kc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
.kc-item{display:flex;align-items:flex-start;gap:9px;padding:10px 12px;background:rgba(255,255,255,0.03);border-radius:var(--r-md);border:1px solid rgba(255,255,255,0.05)}
.kc-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:5px}
.kc-text{font-size:12px;color:var(--ink2);line-height:1.5}
.kc-text strong{color:var(--ink);font-weight:600;display:block;margin-bottom:1px;font-size:12px}

/* EXPANDABLE BLOCKS */
.block{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);margin-bottom:14px;overflow:hidden;transition:border-color 0.2s,box-shadow 0.2s}
.block:hover{border-color:var(--border2)}
.block.open{border-color:rgba(59,130,246,0.25);box-shadow:0 0 0 1px rgba(59,130,246,0.08),0 8px 32px rgba(0,0,0,0.3)}
.block-hdr{display:flex;align-items:center;gap:14px;padding:18px 22px;cursor:pointer;user-select:none}
.b-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.bi-blue{background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.2)}
.bi-teal{background:rgba(20,184,166,0.12);border:1px solid rgba(20,184,166,0.2)}
.bi-amber{background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.2)}
.bi-violet{background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.2)}
.bi-rose{background:rgba(244,63,94,0.12);border:1px solid rgba(244,63,94,0.2)}
.bi-green{background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.2)}
.b-title{font-family:var(--font-h);font-size:15px;font-weight:700;color:#fff;letter-spacing:-0.01em}
.b-sub{font-size:12px;color:var(--ink3);margin-top:2px}
.b-chev{margin-left:auto;font-size:18px;color:var(--ink3);transition:transform 0.3s;flex-shrink:0}
.block.open .b-chev{transform:rotate(180deg);color:var(--blue2)}
.b-body{max-height:0;overflow:hidden;transition:max-height 0.45s cubic-bezier(0.4,0,0.2,1)}
.block.open .b-body{max-height:4000px}
.b-inner{padding:0 22px 22px;border-top:1px solid var(--border);margin:0 4px}

/* CONTENT */
.c-intro{font-size:13px;color:var(--ink2);line-height:1.75;padding:14px 0;border-bottom:1px solid var(--border);margin-bottom:14px}
.s-head{font-family:var(--font-h);font-size:12px;font-weight:700;color:var(--ink);letter-spacing:0.05em;text-transform:uppercase;margin:18px 0 10px;display:flex;align-items:center;gap:8px}
.s-head::after{content:'';flex:1;height:1px;background:var(--border)}
ul.blist{list-style:none;display:flex;flex-direction:column;gap:7px;margin-bottom:14px}
ul.blist li{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--ink2);line-height:1.6}
ul.blist li::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0;margin-top:7px}
ul.blist.teal li::before{background:var(--teal)}
ul.blist.amber li::before{background:var(--amber)}
ul.blist.violet li::before{background:var(--violet)}
ul.blist.rose li::before{background:var(--rose)}
ul.blist.green li::before{background:var(--green)}
ul.blist li strong{color:var(--ink);font-weight:600}

.callout{display:flex;gap:11px;align-items:flex-start;padding:12px 16px;border-radius:var(--r-md);font-size:12.5px;line-height:1.65;margin:12px 0}
.callout-ico{font-size:15px;flex-shrink:0;margin-top:1px}
.c-warn{background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.18);color:#C68B00}
.c-info{background:rgba(59,130,246,0.07);border:1px solid rgba(59,130,246,0.15);color:var(--blue3)}
.c-danger{background:rgba(244,63,94,0.08);border:1px solid rgba(244,63,94,0.18);color:var(--rose2)}
.c-success{background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.18);color:var(--green2)}
.callout strong{font-weight:600}

/* TERMINOLOGY GRID */
.term-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:10px;margin-bottom:14px}
.term-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-md);padding:12px 14px;transition:border-color 0.2s}
.term-card:hover{border-color:rgba(59,130,246,0.35)}
.term-abbr{font-family:var(--font-m);font-size:11px;color:var(--blue2);background:rgba(59,130,246,0.1);padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:5px}
.term-name{font-size:13px;font-weight:600;color:var(--ink);margin-bottom:3px}
.term-desc{font-size:12px;color:var(--ink3);line-height:1.5}

/* WORKFLOW STEPS */
.wf-steps{display:flex;flex-direction:column;gap:0;position:relative;margin:14px 0}
.wf-steps::before{content:'';position:absolute;left:19px;top:22px;bottom:22px;width:2px;background:linear-gradient(180deg,var(--blue),var(--teal));border-radius:1px}
.wf-step{display:flex;gap:16px;align-items:flex-start;padding-bottom:22px}
.wf-step:last-child{padding-bottom:0}
.wf-n{width:40px;height:40px;border-radius:50%;background:var(--surface2);border:2px solid var(--blue);display:flex;align-items:center;justify-content:center;font-family:var(--font-m);font-size:11px;font-weight:500;color:var(--blue2);flex-shrink:0;position:relative;z-index:1}
.wf-c{padding-top:8px;flex:1}
.wf-title{font-size:13px;font-weight:600;color:#fff;margin-bottom:4px}
.wf-desc{font-size:12.5px;color:var(--ink2);line-height:1.65}
.wf-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.wf-tag{font-family:var(--font-m);font-size:10px;padding:2px 7px;border-radius:3px;background:rgba(59,130,246,0.1);color:var(--blue3);border:1px solid rgba(59,130,246,0.15)}
.wf-tag.t{background:rgba(20,184,166,0.1);color:var(--teal2);border-color:rgba(20,184,166,0.15)}
.wf-tag.a{background:rgba(245,158,11,0.1);color:var(--amber2);border-color:rgba(245,158,11,0.15)}

/* QA BOX */
.qa-box{background:rgba(139,92,246,0.06);border:1px solid rgba(139,92,246,0.2);border-radius:var(--r-lg);padding:18px 22px;margin-top:18px}
.qa-title{font-family:var(--font-h);font-size:12px;font-weight:700;color:var(--violet2);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:11px;display:flex;align-items:center;gap:8px}
.qa-list{list-style:none;display:flex;flex-direction:column;gap:7px}
.qa-list li{display:flex;align-items:flex-start;gap:9px;font-size:12.5px;color:var(--ink2);line-height:1.55}
.qa-list li::before{content:'TC';font-family:var(--font-m);font-size:9px;font-weight:500;color:var(--violet2);background:rgba(139,92,246,0.1);padding:1px 5px;border-radius:3px;flex-shrink:0;margin-top:2px}

/* COMPLIANCE TABLE */
.comp-table{width:100%;border-collapse:collapse;font-size:12.5px;margin:12px 0}
.comp-table th{text-align:left;padding:9px 13px;background:var(--surface2);color:var(--ink3);font-weight:600;font-family:var(--font-m);font-size:10px;text-transform:uppercase;letter-spacing:0.07em;border-bottom:1px solid var(--border)}
.comp-table td{padding:10px 13px;border-bottom:1px solid var(--border);color:var(--ink2);vertical-align:top;line-height:1.5}
.comp-table tr:last-child td{border-bottom:none}
.comp-table tr:hover td{background:rgba(255,255,255,0.02)}
.comp-table td:first-child{font-family:var(--font-m);font-size:10.5px;color:var(--blue2);white-space:nowrap}

/* REFERENCES */
.ref-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:9px;margin:12px 0 24px}
.ref-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-md);padding:13px 15px;display:flex;gap:11px;align-items:flex-start;cursor:pointer;text-decoration:none;transition:all 0.2s}
.ref-card:hover{border-color:rgba(59,130,246,0.4);transform:translateY(-1px);box-shadow:0 4px 14px rgba(59,130,246,0.1)}
.ref-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.ri-yt{background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2)}
.ri-web{background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.2)}
.ri-doc{background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.2)}
.ref-text strong{display:block;font-size:12px;font-weight:600;color:var(--ink);margin-bottom:2px}
.ref-text span{font-size:11px;color:var(--ink3)}
.ref-url{font-family:var(--font-m);font-size:10px;color:var(--blue3);margin-top:3px;word-break:break-all}

/* QUIZ */
.quiz-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);overflow:hidden;margin-top:32px;box-shadow:0 8px 32px rgba(0,0,0,0.35)}
.quiz-hd{background:linear-gradient(135deg,var(--surface2),var(--surface3));padding:20px 26px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border)}
.quiz-hd-title{font-family:var(--font-h);font-size:16px;font-weight:700;color:#fff}
.quiz-hd-sub{font-size:11px;color:var(--ink3);margin-top:2px;font-family:var(--font-m)}
.q-badge{background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.22);border-radius:20px;padding:5px 14px;font-family:var(--font-m);font-size:12px;color:var(--blue2)}
.quiz-bd{padding:26px}
.q-prog-row{display:flex;align-items:center;gap:10px;margin-bottom:20px}
.q-prog-track{flex:1;height:3px;background:var(--surface3);border-radius:2px;overflow:hidden}
.q-prog-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--teal));border-radius:2px;transition:width 0.3s}
.q-prog-lbl{font-family:var(--font-m);font-size:11px;color:var(--ink3);white-space:nowrap}
.quiz-q{font-family:var(--font-h);font-size:15px;font-weight:600;color:#fff;margin-bottom:16px;line-height:1.5}
.quiz-opts{display:flex;flex-direction:column;gap:8px}
.q-opt{padding:11px 15px;border:1px solid var(--border);border-radius:var(--r-md);font-size:13px;color:var(--ink2);font-family:var(--font-b);background:var(--surface2);cursor:pointer;text-align:left;transition:all 0.15s;display:flex;align-items:center;gap:11px}
.q-opt:hover:not(.answered){border-color:var(--blue);color:var(--ink);background:rgba(59,130,246,0.06)}
.q-letter{width:23px;height:23px;border-radius:6px;background:var(--surface3);display:flex;align-items:center;justify-content:center;font-family:var(--font-m);font-size:10px;flex-shrink:0;color:var(--ink3);transition:all 0.15s}
.q-opt:hover:not(.answered) .q-letter{background:rgba(59,130,246,0.2);color:var(--blue2)}
.q-opt.correct{border-color:var(--green);background:rgba(16,185,129,0.07);color:var(--green2)}
.q-opt.correct .q-letter{background:var(--green);color:#fff}
.q-opt.wrong{border-color:var(--rose);background:rgba(244,63,94,0.07);color:var(--rose2)}
.q-opt.wrong .q-letter{background:var(--rose);color:#fff}
.q-opt.answered{cursor:default}
.q-fb{display:none;margin-top:13px;padding:13px 15px;background:var(--surface2);border-radius:var(--r-md);font-size:13px;color:var(--ink2);line-height:1.65;border-left:3px solid var(--blue)}
.q-fb.show{display:block}
.q-actions{display:flex;justify-content:flex-end;margin-top:18px}
.btn-next{padding:10px 22px;background:linear-gradient(135deg,var(--blue),#2563EB);color:#fff;border:none;border-radius:var(--r-md);font-size:13px;font-weight:600;font-family:var(--font-h);cursor:pointer;display:none;transition:opacity 0.15s;letter-spacing:0.02em}
.btn-next:hover{opacity:0.88}
.btn-next.show{display:block}
.quiz-done{display:none;text-align:center;padding:30px}
.quiz-done.show{display:block}
.done-emoji{font-size:44px;margin-bottom:10px}
.done-score{font-family:var(--font-h);font-size:44px;font-weight:800;color:#fff}
.done-lbl{font-size:13px;color:var(--ink3);margin-bottom:18px;font-family:var(--font-m)}
.done-bar-wrap{height:7px;background:var(--surface3);border-radius:4px;overflow:hidden;margin-bottom:18px}
.done-bar{height:100%;border-radius:4px;transition:width 0.6s}
.done-msg{font-size:14px;color:var(--ink2);margin-bottom:22px;line-height:1.6;max-width:380px;margin-left:auto;margin-right:auto}
