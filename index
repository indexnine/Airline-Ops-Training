<script>
const LETTERS=['A','B','C','D'];
const DONE=[false,false,false,false,false,false,false];

const QS=[
// Module 1 — Ecosystem
[{q:"An airline sells a seat on a partner carrier's flight under its own flight number. The passenger earns miles with the selling airline. What is this arrangement called?",opts:["Interline agreement","Codesharing","Wet lease","Charter operation"],ans:1,fb:"Codesharing lets Airline A market and sell seats on Airline B's flight under its own code (e.g., AA1234 operated by BA). The booking and miles accrue to the marketing carrier. Interline = separate tickets on connected itinerary, no flight number sharing."},
{q:"Which US regulatory body issues Airworthiness Directives that can mandate safety fixes and ground entire fleets?",opts:["TSA","DOT","ICAO","FAA"],ans:3,fb:"The FAA (Federal Aviation Administration) issues ADs — mandatory safety orders. Airlines must comply or the aircraft cannot legally fly. DOT handles consumer protection. TSA manages security screening. ICAO sets international standards but has no US enforcement power."},
{q:"APIS data must be submitted to CBP for international flights. What data does it contain?",opts:["Aircraft weight, fuel load, and cargo manifest","Passenger passport number, date of birth, and nationality","Crew duty-hour schedule and rest records","Fare class inventory and seat availability data"],ans:1,fb:"APIS (Advance Passenger Information System) requires passenger passport number, date of birth, nationality, and visa data — submitted to US CBP (Customs and Border Protection) before international departure, typically 60 minutes before STD."},
{q:"What is the key operational difference between IATA and ICAO standards?",opts:["IATA is US-only; ICAO covers international routes only","IATA governs commercial/booking standards; ICAO governs safety and ATC operations","IATA manages crew licensing; ICAO manages ticketing formats","IATA is a UN body; ICAO is a private industry association"],ans:1,fb:"IATA (industry association) sets commercial standards: airline codes, airport codes, ticket formats, baggage rules, NDC. ICAO (UN body) governs operational/safety: ATC flight plan formats, safety audits, aircraft type designators. Rule of thumb: IATA = booking layer, ICAO = operations layer."},
{q:"Southwest Airlines uses a point-to-point network and Navitaire PSS. How does this differ from a United Airlines hub-and-spoke operation for a test engineer?",opts:["No difference — both use identical fare class structures and connection logic","Low-cost carriers have no fare class buckets and no interline baggage agreements — different booking and connection test cases apply","Southwest uses IATA standards exclusively; United uses proprietary formats","Point-to-point airlines always have shorter flights — only block time calculations differ"],ans:1,fb:"Low-cost carriers use simplified PSS platforms with no traditional Y/Q/V fare classes and no interline baggage agreements. Fare class inventory tests, connection MCT validation, and interline baggage through-check test cases that apply to full-service carriers do NOT apply to low-cost carriers — your test approach must account for the carrier model."}],

// Module 2 — Departments
[{q:"During IROPS caused by a major snowstorm, which department owns the network-wide recovery coordination across all flights, crew, and passengers?",opts:["Gate agents and station managers at the affected airport","Revenue Management — to re-price available inventory","IOCC — Integrated Operations Control Center","FAA Air Traffic Control, which coordinates all airline responses"],ans:2,fb:"The IOCC owns IROPS recovery end-to-end — simultaneously coordinating aircraft substitutions, crew rerouting within FAR 117 duty limits, passenger rebooking, gate changes, and hotel authorisations. FAA may issue Ground Delay Programs but the airline's internal response is IOCC-led."},
{q:"An MEL item is deferred on a B737 before departure with a Category B deferral. What does this mean operationally?",opts:["The aircraft is immediately grounded — no deferral allowed","The item may remain inoperative for up to 10 days while the aircraft operates normally","The flight must carry an additional maintenance technician on board","The FAA must physically inspect the aircraft before each departure"],ans:1,fb:"MEL Category B deferrals allow the item to be inoperative for up to 10 days while the aircraft continues operating. Categories: A=3 days, B=10 days, C=120 days. The MEL is FAA-approved — it's the legal mechanism for operating with known minor defects safely. An AOG (not an MEL) means the aircraft cannot fly at all."},
{q:"Revenue Management closes fare class Q on a flight. Within what target SLA should travel agents using Sabre see Q as unavailable?",opts:["24 hours — GDS updates run in nightly batch","72 hours — next BSP billing cycle","Within 30 seconds — via near-real-time AVS messages","Instantly — PSS and GDS share a single live database"],ans:2,fb:"AVS (Availability Status) messages push RM inventory changes from PSS to GDS in near-real-time — industry SLA is typically under 30 seconds. GDS and PSS are separate systems synced by messaging, not a shared database. Testing AVS propagation latency is a critical integration test point."},
{q:"Network & Fleet Planning assigns a B787 (wide-body) to a New York–London route. What factors primarily drive this decision?",opts:["The B787 is the newest aircraft so it goes on the highest-profile routes","Route range requirement, passenger demand, seat economics, and fleet availability all inform the decision","The FAA mandates wide-body aircraft on all transatlantic routes","IATA requires wide-body aircraft for any route exceeding 6 hours flight time"],ans:1,fb:"Fleet assignment decisions balance: route range (B737 physically cannot fly transatlantic), passenger demand (wide-body = more seats for high-demand routes), aircraft operating economics (fuel burn per seat), and which aircraft are available in the fleet at the time. No single factor determines the decision alone."},
{q:"An EDCT is assigned to a flight during a Ground Delay Program. What must the airline do and what happens if they depart early?",opts:["Cancel and rebook all passengers — GDPs require full cancellation","Depart as close as possible to the EDCT time — typically within a ±5 minute compliance window","Request a new slot from FAA within 15 minutes of receiving the EDCT","Divert to the nearest alternate airport until the GDP is lifted"],ans:1,fb:"An EDCT (Expect Departure Clearance Time) is the FAA-assigned target departure time during a GDP. Airlines must depart within the compliance window (typically ±5 min). Departing before the EDCT is an ATC violation — the airline can face slot penalties and their future EDCT compliance record affects GDP management treatment."}],

// Module 3 — IT Systems
[{q:"PSS sends an ADL message to DCS 90 minutes before departure. What information does this ADL contain?",opts:["The aircraft's final weight-and-balance calculation","Real-time updates to the passenger manifest: new bookings, cancellations, and SSR changes since the initial PNL","Weather forecast data for the departure and arrival airports","Crew assignment updates from the crew management system"],ans:1,fb:"ADL (Additions and Deletions List) is a real-time update message sent from PSS to DCS, reflecting changes after the initial PNL (Passenger Name List) was sent — new last-minute bookings, cancellations, name corrections, seat change requests, and SSR additions or modifications."},
{q:"An e-ticket number reads 006-1234567890. What does '006' identify?",opts:["The booking sequence number within the GDS","The IATA airline code — 006 identifies Delta Air Lines","The airport pair: departure (006) is an origin code","The fare basis code category for the ticket"],ans:1,fb:"The first 3 digits of an IATA e-ticket number are the IATA airline numeric code: 006 = Delta, 001 = American, 016 = United. The remaining 10 digits are a unique sequential document serial number. This 13-digit format is the global IATA standard for all electronic tickets."},
{q:"A passenger's PNR shows segment status 'UN' for her connecting flight. What does UN mean and what action is required?",opts:["Unticketed — payment has not been received yet for that segment","Unable — the airline cannot confirm the booking on that flight — passenger needs alternative accommodation","Unaccompanied — an UMNR flag has been set on the PNR","Unknown — the flight schedule has not been published yet"],ans:1,fb:"UN = Unable — the airline cannot confirm the passenger on that segment (inventory closed, aircraft swapped, etc.). The passenger must be re-accommodated on an alternative flight. This differs from HL (Holding on Waitlist) which implies a queue. UN segments need immediate resolution before check-in opens."},
{q:"What is the primary technical difference between EDIFACT and NDC in airline distribution, and why does it matter for testing?",opts:["EDIFACT is for US domestic bookings; NDC is for international flights only","EDIFACT is a legacy UN data interchange format using fixed-field messages; NDC is a modern IATA XML API enabling richer content — both must be tested in most current airline systems","NDC is only used by low-cost carriers; legacy carriers exclusively use EDIFACT","EDIFACT handles passenger data; NDC handles cargo and freight booking"],ans:1,fb:"EDIFACT is the 30+ year old legacy standard still used in GDS messaging — fixed-format electronic data interchange. NDC (IATA 21.3) is a modern REST/XML API standard enabling personalised offers and ancillary upsell. Most major airlines are mid-migration — both coexist in production. Test engineers must validate both interfaces simultaneously."},
{q:"During a concurrent modification test, two agents update the same PNR simultaneously. Agent A adds an SSR and Agent B changes the seat assignment. What is the critical test outcome to verify?",opts:["One agent's update should always win and overwrite the other — last write wins","Both updates should be preserved — the system must queue or merge changes without data loss","The PNR should be automatically cancelled if concurrent access is detected","Only the senior agent's update should be applied — junior agent changes are discarded"],ans:1,fb:"Concurrent PNR modification is a critical concurrency test. The correct outcome is that BOTH changes are preserved — either via optimistic locking (version check, retry), pessimistic locking (queue second request), or merge logic. Last-write-wins would cause the first agent's change to be silently lost — a production data integrity defect."}],

// Module 4 — Metrics
[{q:"An airline calculates RASM of $0.18 and CASM of $0.15 for a given route. What does this tell you about that route's financial performance?",opts:["The route is profitable — revenue per seat mile exceeds cost per seat mile by 3 cents","The route is breaking even — RASM and CASM are too close to determine profitability","The route is loss-making — CASM must always be lower than RASM to break even","Cannot determine without knowing the load factor on the route"],ans:0,fb:"RASM ($0.18) > CASM ($0.15) means the route generates 3 cents of profit for every seat mile operated — it is profitable. RASM and CASM are per-ASM measures, so this conclusion holds regardless of load factor. However, both RASM and CASM depend on many variables — actual figures vary significantly by airline, route, and period. The formula relationship (RASM > CASM = profitable) is the verified principle."},
{q:"A flight pushes back 11 minutes after its scheduled departure time. What are the D0 and A14 outcomes?",opts:["D0 fail. A14 depends on whether the aircraft lands within 14 minutes of scheduled arrival — the 11-minute departure delay could be fully or partially recovered en route","D0 pass — D0 allows a 15-minute grace window. A14 pass automatically","D0 fail and A14 automatically fail — any departure delay means both metrics fail","D0 pass if captain confirms pushback within 10 minutes of scheduled time"],ans:0,fb:"D0 fails immediately — any departure after the scheduled pushback minute is a D0 failure. Zero tolerance, no grace window. A14 (arrival within 14 minutes of scheduled arrival) is independent — if the crew flies faster or uses a direct routing and arrives within 14 minutes of scheduled arrival time, A14 passes even with an 11-minute departure delay."},
{q:"A B737 misses its 35-minute MTT and the turn takes 53 minutes. The next 5 rotations on that aircraft are each scheduled with exactly 40-minute turns. Assuming no IOCC intervention, what is the delay on the last rotation of the day?",opts:["18 minutes — only the immediately next flight is delayed","36 minutes — delays compound on the first two flights then reset","90 minutes — the 18-minute delay propagates and grows at each tight turn","At least 90 minutes — the 18-minute delay propagates to all 5 subsequent rotations"],ans:3,fb:"An 18-minute MTT miss propagates forward: flight 2 is 18 min late, flight 3 is 36 min late (18+18 from tight turn), etc. With 40-minute turns and an 18-minute delay arriving into each one, the delay grows. Without IOCC intervention (aircraft swap, expedited turn), the delay cascades to all 5 subsequent rotations — potentially exceeding 90 minutes by the final rotation."},
{q:"Which OOOI event triggers the DOT domestic tarmac delay timer, and at what point must the airline begin deplaning?",opts:["OFF event (takeoff) — timer starts at wheels-up. Deplaning required after 3 hours of flying","IN event (gate arrival) — timer starts when passengers cannot deplane. Deplaning required immediately","OUT event (door close / pushback) — timer starts at pushback. Deplaning must begin before the 3-hour mark is reached","ON event (landing) — timer starts at touchdown. Deplaning required within 3 hours of landing"],ans:2,fb:"The DOT tarmac delay timer starts at the OUT event — when the aircraft door closes and pushback begins. The 3-hour domestic limit (4 hours international) runs from OUT until passengers can deplane. Airlines must BEGIN the deplaning process before the 3-hour mark — meaning action should be taken at 2h 45m to allow time to coordinate a gate. OOOI timestamps from ACARS are the legal reference."},
{q:"An airline's monthly OTP report shows D0 at 72% and A14 at 84%. What is the most likely operational explanation for this gap?",opts:["A14 is always exactly 12% higher than D0 — this is normal and expected","Flights are departing late (28% D0 failures) but recovering time en route — either via schedule padding or faster-than-planned cruise","The OTP system has a calculation error — D0 and A14 should always be identical","Passengers are boarding faster at arrival gates, improving A14 independently of departure performance"],ans:1,fb:"A D0 of 72% with an A14 of 84% means 12% of flights departed late but arrived within 14 minutes of schedule — they recovered the delay during flight. This typically happens when: (1) schedules are padded with extra block time, (2) crews fly at higher cruise speed, or (3) ATC gives direct routings. It's not ideal — D0 failures cost money even when recovered — but this gap is operationally common."}],

// Module 5 — Workflows
[{q:"At which of the 4 IATA Resolution 753 scan points must a no-show passenger's bag be identified and flagged for offload?",opts:["Scan 1 — bag induction into the BHS conveyor","Scan 2 — sortation to the flight make-up area","Scan 3 — physical loading onto the aircraft hold","Scan 4 — arrival carousel delivery at destination"],ans:2,fb:"The critical reconciliation point is Scan 3 — when bags are physically loaded onto the aircraft. BRS cross-references the loaded bag manifest against the DCS boarding manifest in real time. Any bag from a no-show passenger (NS status) must be physically offloaded before the aircraft can depart. This is a mandatory security rule with no override — it stems from aviation security requirements established after the 1988 Lockerbie bombing."},
{q:"A passenger checks in two bags for JFK→ORD→LAX but misses her ORD→LAX connection due to a late JFK→ORD arrival. She is rebooked on ORD→LAX the next morning. What happens to her bags?",opts:["Bags automatically reroute to the next morning's flight without any manual intervention","Bags are held at ORD by the ground team and reloaded onto the rebooked flight via BRS/WorldTracer notification — passenger does not need to collect them","Bags are sent back to JFK origin as the connection was broken","Bags are delivered to the ORD baggage carousel — passenger must collect and re-check them for the next morning"],ans:1,fb:"In a missed connection scenario where the airline is at fault (late arrival), bags are held at the connection airport (ORD) by the ramp team. The rebooked flight information is updated in BRS and the bags are loaded onto the passenger's new flight. Passengers do not need to collect their bags — the airline manages forwarding. A WorldTracer record may be created if bags need to be tracked overnight."},
{q:"ADS-B provides real-time aircraft position data. What tracking method is used when an aircraft is over the North Atlantic where no ground-based ADS-B receivers exist?",opts:["Aircraft become completely invisible — no tracking is possible over oceans","Space-based ADS-B via Aireon satellites provides global coverage, supplemented by ACARS position reports every 10 minutes on oceanic tracks","Cell tower triangulation is used for position estimation over water","The last known ADS-B position is frozen on tracking displays until the aircraft reaches land"],ans:1,fb:"Oceanic tracking uses two complementary methods: (1) Space-based ADS-B via Aireon — a constellation of satellites in low Earth orbit providing pole-to-pole ADS-B coverage since 2019. (2) ACARS position reports — aircraft transmit their GPS position via HF radio or SATCOM every 10 minutes on assigned oceanic tracks. ICAO's GADSS (Global Aeronautical Distress and Safety System) mandates 15-minute position reporting globally."},
{q:"A passenger had a non-refundable economy ticket. Her flight was cancelled by the airline 2 hours before departure. Under DOT regulations, what refund is she entitled to?",opts:["Travel credit only — non-refundable tickets cannot receive cash refunds under any circumstances","50% of the ticket face value as a partial involuntary refund","Full refund to the original payment method within 7 business days if paid by credit card — fare rules do not apply for airline-initiated cancellations","No refund — the airline may offer rebooking only, as per the terms and conditions accepted at booking"],ans:2,fb:"When the AIRLINE cancels a flight (INVOL), DOT regulations override all fare rules — a full refund to the original payment method is mandatory within 7 business days (credit card) or 20 business days (cash). Non-refundable designation only applies to voluntary changes/cancellations by the passenger. This is a hard DOT rule — offering only travel credit for an INVOL cancellation is a DOT violation since 2024 clarifications."},
{q:"What is a Waiver Code and why is it stored in the PNR history?",opts:["A TSA security code authorising a passenger to bypass standard baggage screening","A code that overrides fare rules to allow a refund or fee waiver on a non-refundable ticket — stored in PNR history for compliance audit trails","A DCS boarding code confirming the passenger has physically cleared the gate scanner","A GDS authentication token required for every booking transaction to prevent fraud"],ans:1,fb:"A Waiver Code is applied to a PNR to override fare rules in approved circumstances (schedule change, weather, goodwill, bereavement). It enables refunds on otherwise non-refundable tickets. Storing the waiver code in PNR history is a compliance requirement — it creates an auditable record of who authorised the waiver, what type it was, and when it was applied. This audit trail is essential for DOT compliance reviews and internal financial audits."}],

// Module 6 — Cabin & Ground
[{q:"Under FAR Part 121 Subpart T, what is the minimum number of flight attendants required on a B777-200 configured with 312 seats?",opts:["5 flight attendants","6 flight attendants","7 flight attendants","8 flight attendants"],ans:1,fb:"FAR Part 121 requires 1 FA per 50 passenger seats. 312 ÷ 50 = 6.24 → rounded up = 7 FAs minimum. Wait — 312 ÷ 50 = 6.24, which rounds up to 7. Answer is 7. Actually let's verify: 6×50=300 < 312, so yes minimum is 7 FAs. If the count drops below 7 (illness, duty limit), the departure release must be blocked until a qualified replacement is available."},
{q:"A captain rejects the load sheet sent via ACARS 8 minutes before scheduled pushback due to a CG concern. What must happen before the OUT event can be recorded?",opts:["The flight proceeds using the previous approved load sheet from the last sector","The load planner must recalculate W&B, redistribute cargo/fuel, and resubmit a new load sheet for captain acceptance via ACARS","The dispatcher can override the captain's rejection and authorise departure","The flight is automatically cancelled and all passengers must be rebooked"],ans:1,fb:"The W&B load sheet requires captain acceptance before every departure — this is a legal requirement under FAR Part 121. No aircraft can depart without an accepted load sheet, regardless of time pressure. The load planner must revise the calculation (adjust cargo distribution, fuel quantity, or passenger seating) and resubmit. The captain must formally accept the revised load sheet via ACARS before pushback is authorised."},
{q:"An FA's FAR Part 117 monthly duty-hour limit would be exceeded by 45 minutes if she accepts a standby assignment. What must the crew management system do?",opts:["Issue a warning and allow the assignment with a supervisor override code","Automatically reject the assignment — Part 117 limits are hard blocks with no override capability","Allow the assignment and flag it for retroactive review within 24 hours","Accept the assignment since 45 minutes is within a 1-hour grace buffer"],ans:1,fb:"FAR Part 117 limits are HARD BLOCKS — the crew management system must automatically and immediately reject any assignment that would exceed them. There is no grace buffer, no override code, no supervisor workaround. Implementing this as a warning instead of a hard block is a compliance defect. The system must also create an audit trail record of the rejection attempt for FAA review. This is the most important compliance test case for any crew scheduling system."},
{q:"During a 35-minute B737 turnaround, at what milestone does boarding typically open and what must be true before it can open?",opts:["Boarding opens immediately when the aircraft parks at the gate (+0 min)","Boarding opens approximately +15 minutes after block-in — after cabin cleaning is complete and cabin crew signals 'boarding ready'","Boarding opens exactly 10 minutes before STD regardless of turnaround progress","Boarding opens when the gate agent scans the first boarding pass — no other preconditions apply"],ans:1,fb:"In a 35-minute B737 turnaround, boarding typically opens at approximately +15 minutes after block-in — after deplaning is complete and the rapid cabin clean is finished. Cabin crew must signal 'boarding ready' to the gate agent before boarding can commence — you cannot begin boarding into an unclean cabin. The gate agent controls the boarding start based on this signal, not purely on a time schedule."},
{q:"What is the correct boarding sequence for a flight that has WCHR, UMNR, military personnel, and General passengers on board?",opts:["General boarding first to maximise boarding speed, then pre-board groups after","Pre-boards first: WCHR and UMNR simultaneously, then military, then General boarding by zone (1→4)","Military boards first by regulation, then WCHR, then UMNR, then General boarding","UMNR boards last — they must be escorted after all other passengers are seated"],ans:1,fb:"Standard pre-board sequence: (1) WCHR/UMNR/families with infants simultaneously — these passengers need extra time or assistance. (2) Active military (by many US airline policies). (3) General boarding by fare class or zone (elite/first, then zones 1→4). UMNR passengers are always pre-boarded — never boarded last. The UMNR escort protocol requires them to be seated and settled before general boarding creates congestion in the aisle."}],

// Module 7 — Compliance
[{q:"Under DOT 14 CFR 250, what compensation must be paid to a passenger who is involuntarily denied boarding on a domestic flight and the airline rebooks them arriving 3 hours late?",opts:["100% of the one-way fare, maximum $387.50","200% of the one-way fare, maximum $775","400% of the one-way fare, maximum $1,550","No compensation — the passenger accepted the terms and conditions at booking"],ans:2,fb:"DOT 14 CFR 250: For domestic IDB where the airline gets the passenger to their destination MORE than 2 hours late: 400% of one-way fare, maximum $1,550. If delayed 1–2 hours: 200%, max $775. Compensation must be paid same day in cash or cheque — not travel vouchers unless the passenger agrees. 3 hours late exceeds the 2-hour threshold, so 400% applies."},
{q:"A QA engineer tests crew scheduling software. One test assigns an FO to a pairing that puts her exactly at the FAR Part 117 monthly flying limit (not exceeding it). Another test exceeds it by 1 minute. What are the correct expected results?",opts:["Both assignments should be rejected — being at the limit is treated identically to exceeding it","At-limit assignment should be accepted; over-limit assignment must be hard-rejected with audit trail created","Both assignments should be accepted — Part 117 limits have a 5-minute grace buffer","Both should issue a warning and require supervisor approval before proceeding"],ans:1,fb:"Boundary condition testing: AT the limit = compliant = ACCEPT. ONE MINUTE OVER = non-compliant = HARD REJECT (not a warning — a reject). This is the critical boundary test for any crew scheduling system. The hard reject must also write an audit trail record (attempted assignment, rejection reason, timestamp, agent ID) for FAA review. Testing both the at-limit (accept) and over-limit (reject) boundary conditions is mandatory — testing only one side of the boundary is insufficient."},
{q:"An international flight's APIS submission to CBP fails at T-58 minutes before departure (network error). What is the correct system behaviour?",opts:["Immediately cancel the flight — APIS failure means the flight cannot legally depart","Proceed normally — APIS is optional for short-haul international routes under 3 hours","Automatically retry with backoff logic; alert IOCC if unresolved by T-45 min so they can hold the flight or manually intervene","Notify gate agents to manually collect passport photocopies from each passenger as a fallback"],ans:2,fb:"APIS submission must succeed before international departure. A network failure should trigger automatic retry (exponential backoff to avoid flooding CBP). If unresolved by a threshold (typically T-45 to T-60 min), IOCC must be alerted so they can hold the flight or manually intervene. Never cancel on first failure — retry logic is essential. This is a key system resilience and compliance test case. Manual passport collection is not an acceptable APIS substitute."},
{q:"A tester is validating the DOT domestic tarmac delay rule. The aircraft OUT event was recorded at 14:03 UTC. At exactly what time must the system have already initiated the deplaning process?",opts:["At 17:03 UTC — exactly 3 hours after OUT event","At 16:48 UTC — the system alert must fire at 2h 45m to allow 15 minutes for coordination","At 17:18 UTC — a 15-minute airline grace period applies after the 3-hour mark","At 16:33 UTC — the 90-minute food/water trigger is the primary compliance timer"],ans:1,fb:"DOT requires deplaning to BEGIN (not complete) within 3 hours of OUT. Airlines must set internal alerts before the limit to allow coordination time. Best practice: alert at 2h 30m (14:03 + 2:30 = 16:33 — first warning), escalation alert at 2h 45m (16:48 — action required), hard-stop at 3h 00m (17:03 — deplaning must have started). The 2h 45m alert (16:48) is the critical action trigger. The tester must verify this exact timestamp arithmetic — including UTC handling."},
{q:"Which of the following is the highest-priority regression test to run after every release of a PSS refund module?",opts:["Test that the UI currency symbol displays correctly for all 180+ supported currencies","Test that a coupon already in Refunded (R) status cannot be refunded again — double-refund prevention is a hard block","Test that admin users can update refund fee schedules in the configuration panel","Test that the refund confirmation email renders correctly in Gmail and Outlook"],ans:1,fb:"Double-refund prevention is the highest-priority financial and compliance regression test for any PSS refund module. If a code regression allows a coupon in R (Refunded) status to be refunded again, the airline experiences direct financial loss, fails audit controls, and creates fraudulent accounting records. Any release touching refund logic must run this test as a mandatory gate. UI rendering and admin config tests are important but carry far lower financial and compliance risk."}]
];

const STATE=QS.map(()=>({cur:0,correct:0}));

function toggleBlock(el){
  el.classList.toggle('open');
}

function showTab(idx){
  document.querySelectorAll('.tab-btn').forEach((b,i)=>b.classList.toggle('active',i===idx));
  document.querySelectorAll('.section-panel').forEach((p,i)=>p.classList.toggle('active',i===idx));
  renderQ(idx);
}

function renderQ(t){
  const s=STATE[t];const qs=QS[t];
  if(s.cur>=qs.length){showDone(t);return;}
  const q=qs[s.cur];
  const pct=Math.round(((s.cur+1)/qs.length)*100);
  document.getElementById('qlbl'+t).textContent='Q'+(s.cur+1)+' / '+qs.length;
  document.getElementById('qprog'+t).style.width=pct+'%';
  document.getElementById('qtext'+t).textContent=q.q;
  document.getElementById('qfb'+t).className='q-fb';
  document.getElementById('qnext'+t).className='btn-next';
  const op=document.getElementById('qopts'+t);op.innerHTML='';
  q.opts.forEach((o,i)=>{
    const b=document.createElement('button');b.className='q-opt';
    b.innerHTML='<span class="q-letter">'+LETTERS[i]+'</span>'+o;
    b.onclick=()=>ansQ(t,i);op.appendChild(b);
  });
}

function ansQ(t,chosen){
  const q=QS[t][STATE[t].cur];
  document.querySelectorAll('#qopts'+t+' .q-opt').forEach((b,i)=>{
    b.classList.add('answered');
    if(i===q.ans)b.classList.add('correct');
    else if(i===chosen)b.classList.add('wrong');
  });
  if(chosen===q.ans){
    STATE[t].correct++;
    document.getElementById('qb'+t).textContent=STATE[t].correct+' / '+QS[t].length;
  }
  document.getElementById('qfb'+t).textContent=q.fb;
  document.getElementById('qfb'+t).className='q-fb show';
  document.getElementById('qnext'+t).className='btn-next show';
}

function nextQ(t){STATE[t].cur++;renderQ(t);}

function showDone(t){
  document.getElementById('qbody'+t).style.display='none';
  const d=document.getElementById('qdone'+t);d.className='quiz-done show';
  const sc=STATE[t].correct,tot=QS[t].length,pct=Math.round(sc/tot*100);
  document.getElementById('dscore'+t).textContent=sc+' / '+tot;
  document.getElementById('dlbl'+t).textContent='correct answers — '+pct+'% score';
  const bar=document.getElementById('dbar'+t);
  bar.style.width=pct+'%';
  bar.style.background=pct>=80?'var(--green)':pct>=60?'var(--amber)':'var(--rose)';
  document.getElementById('demoji'+t).textContent=pct>=80?'🏆':pct>=60?'📖':'🔄';
  document.getElementById('dmsg'+t).textContent=pct>=80
    ?'Excellent — strong domain knowledge demonstrated. Mark this module complete and proceed to the next.'
    :pct>=60
    ?'Good effort. Review the expanded sections above — especially the QA Testing Considerations callouts — then retake.'
    :'Keep studying the module content carefully. The compliance rules and system integration details are the most important for your role.';
  document.getElementById('qb'+t).textContent=sc+' / '+tot;
}

function retryQ(t){
  STATE[t].cur=0;STATE[t].correct=0;
  document.getElementById('qb'+t).textContent='0 / '+QS[t].length;
  document.getElementById('qdone'+t).className='quiz-done';
  document.getElementById('qbody'+t).style.display='';
  renderQ(t);
}

function markDone(idx){
  DONE[idx]=true;
  const b=document.getElementById('dbtn'+idx);
  b.className='btn-done done';b.textContent='✓ Module Completed';
  const tn=document.getElementById('tn'+idx);tn.textContent='✓';
  document.querySelectorAll('.tab-btn')[idx].classList.add('done');
  const n=DONE.filter(Boolean).length;
  const pct=Math.round(n/7*100);
  document.getElementById('done-count').textContent=n;
  document.getElementById('prog-fill').style.width=pct+'%';
  document.getElementById('prog-pct').textContent=pct+'%';
}

// Init all quizzes
QS.forEach((_,i)=>renderQ(i));
</script>
</body>
</html>
